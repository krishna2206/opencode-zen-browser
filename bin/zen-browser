#!/usr/bin/env node
import("../dist/adapters/cli.js")
  .then(({ runCli }) => runCli(process.argv.slice(2)))
  .then((code) => {
    if (code !== 0) {
      process.exitCode = code;
    }
  })
  .catch((err) => {
    process.stderr.write(`Error: ${err instanceof Error ? err.message : String(err)}\n`);
    process.exitCode = 1;
  });
