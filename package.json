{
  "name": "opencode-zen-browser",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode 2 plugin and Zen Browser companion extension for human-paced web exploration.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zen-browser": "./bin/zen-browser"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "host",
    "extension",
    ".claude-plugin",
    "skills"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "install-host": "node host/install.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.12",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.5",
    "effect": "4.0.6",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.0",
    "effect": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  },
  "license": "MIT"
}
